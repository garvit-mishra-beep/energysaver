# ==============================================================================
# EnergySaver - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your specific credentials.
# NEVER commit the actual .env file into version control.
# ==============================================================================

# Node Runtime Environment ('development' or 'production')
NODE_ENV=development

# HTTP Server Port
PORT=3000

# Express Trust Proxy Setting
# Set to 'true' only if deployed behind a reverse proxy like Nginx or Cloudflare
TRUST_PROXY=false

# MySQL Database Connectivity
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=energysaver_db
DB_CONNECTION_LIMIT=10

# Session Cryptography & Persistence
# Provide a strong, cryptographically random string (min 32 characters) in production
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars_long

# Session Cookie Name
SESSION_NAME=energysaver_sid

# Session Cookie Security Flags
# Set COOKIE_SECURE=true when operating over HTTPS in production
COOKIE_SECURE=false

# Session Cookie Lifetime in Milliseconds (default: 7 days = 604800000 ms)
SESSION_MAX_AGE_MS=604800000

# Rate Limiting Configuration (Authentication Routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
